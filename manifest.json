{
  "manifest_version": 3,
  "name": "ReviewNudge",
  "version": "0.8.3",
  "description": "Adds a one-click Request Reviews button to Seller Central's orders page. Follows Amazon's 5–30 day window and skips returns and refunds.",
  "homepage_url": "https://github.com/Golps/ReviewNudge",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ReviewNudge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://sellercentral.amazon.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://sellercentral.amazon.com/*"
      ],
      "js": [
        "content/amazon-pages.js",
        "content/orders-page.js"
      ],
      "css": [
        "content/orders-page.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "review-nudge@extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "safari": {
      "strict_min_version": "17.0"
    }
  }
}
